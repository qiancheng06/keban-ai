page { padding-bottom: 50px; }

/* Search Bar */
.search-bar {
  display: flex; align-items: center; gap: 8px;
  background: #fff;
  border-bottom: 1px solid var(--gray-100);
  padding: 12px 16px;
  position: sticky; top: 0; z-index: 10;
}
.search-icon { font-size: 16px; }
.search-input { flex: 1; font-size: var(--font-md); color: var(--gray-800); }
.search-clear { font-size: 14px; color: var(--gray-400); padding: 4px; }

/* Category Tabs */
.cate-tabs {
  display: flex;
  position: relative;
  background: #fff;
  border-bottom: 1px solid var(--gray-100);
}
.cate-tab {
  flex: 1;
  text-align: center;
  padding: 12px 0;
  font-size: var(--font-md);
  color: var(--gray-400);
  transition: .2s;
  position: relative;
  z-index: 1;
}
.cate-tab.active { color: var(--primary); font-weight: 600; }
.cate-indicator {
  position: absolute;
  bottom: 0;
  height: 2px;
  background: var(--primary);
  border-radius: 1px;
  transition: .3s ease;
}

/* Video List */
.video-item {
  display: flex; gap: 12px;
  background: #fff;
  padding: 14px 16px;
  border-bottom: 1px solid var(--gray-50);
  transition: .15s;
}
.video-item:active { background: var(--gray-50); }
.video-thumb {
  width: 110px; height: 66px;
  border-radius: var(--radius-sm);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.thumb-math { background: linear-gradient(135deg, #2563EB, #60A5FA); }
.thumb-code { background: linear-gradient(135deg, #7C3AED, #A78BFA); }
.thumb-eng { background: linear-gradient(135deg, #059669, #34D399); }
.thumb-algebra { background: linear-gradient(135deg, #D97706, #FBBF24); }
.thumb-prob { background: linear-gradient(135deg, #DB2777, #F472B6); }
.thumb-text { color: #fff; font-size: var(--font-sm); font-weight: 700; letter-spacing: 1px; }
.video-info { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 4px; }
.video-title { font-size: var(--font-md); font-weight: 600; color: var(--gray-800); line-height: 1.4; }
.video-meta { font-size: var(--font-sm); color: var(--gray-400); }

/* Feed Card (Notes) */
.feed-card {
  background: #fff;
  padding: 14px 16px;
  border-bottom: 1px solid var(--gray-50);
  transition: .15s;
}
.feed-card:active { background: var(--gray-50); }
.feed-card-title { font-size: var(--font-md); font-weight: 600; margin-bottom: 4px; color: var(--gray-800); }
.feed-card-desc { font-size: var(--font-sm); color: var(--gray-400); line-height: 1.5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.feed-card-meta { font-size: var(--font-xs); color: var(--gray-400); margin-top: 6px; }

/* Buddy */
.buddy-section-hint { font-size: var(--font-sm); color: var(--gray-400); padding: 12px 16px 8px; }
.buddy-card {
  display: flex; align-items: center; gap: 12px;
  background: #fff;
  padding: 12px 16px;
  border-bottom: 1px solid var(--gray-50);
  transition: .15s;
}
.buddy-card:active { background: var(--gray-50); }
.buddy-avatar { font-size: 30px; }
.buddy-info { flex: 1; }
.buddy-name { font-size: var(--font-md); font-weight: 600; }
.buddy-meta { font-size: var(--font-sm); color: var(--gray-400); margin-top: 1px; }
.buddy-tags { display: flex; gap: 4px; margin-top: 6px; flex-wrap: wrap; }
.buddy-tag { font-size: var(--font-xs); background: var(--primary-bg); color: var(--primary); padding: 2px 10px; border-radius: 10px; }
.buddy-btn { font-size: var(--font-sm); color: var(--primary); font-weight: 600; padding: 6px 14px; border: 1px solid var(--primary); border-radius: 16px; background: transparent; line-height: 1; }

/* Empty */
.empty-state { text-align: center; padding: 48px 16px; color: var(--gray-400); font-size: var(--font-md); }
