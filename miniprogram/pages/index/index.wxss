page { padding-bottom: 50px; }

/* ===== Greeting Banner ===== */
.greeting-banner {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  margin: 0;
  padding: 20px 20px 28px;
  color: #fff;
  position: relative;
}
.greeting-banner::after {
  content: '';
  position: absolute;
  bottom: -1px; left: 0; right: 0;
  height: 20px;
  background: var(--gray-50);
  border-radius: 20px 20px 0 0;
}
.greeting-text { font-size: var(--font-xl); font-weight: 400; }
.greeting-name { font-weight: 700; font-size: 20px; }
.greeting-sub { font-size: var(--font-sm); opacity: .8; margin-top: 4px; }

/* ===== Stats Cards ===== */
.stats-row { display: flex; gap: 10px; margin: -14px 16px 16px; position: relative; z-index: 1; }
.stat-card {
  flex: 1;
  border-radius: var(--radius-md);
  padding: 14px 8px;
  text-align: center;
  color: #fff;
  box-shadow: var(--shadow-md);
  transition: .2s;
}
.stat-card:active { transform: scale(.95); }
.stat-card.blue { background: linear-gradient(135deg, #2563EB, #3B82F6); }
.stat-card.green { background: linear-gradient(135deg, #059669, #10B981); }
.stat-card.amber { background: linear-gradient(135deg, #D97706, #F59E0B); }
.stat-number { font-size: var(--font-3xl); font-weight: 800; line-height: 1.1; }
.stat-label { font-size: var(--font-sm); opacity: .9; margin-top: 2px; }

/* ===== Section Label ===== */
.section-label {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--gray-800);
  padding: 16px 20px 10px;
}

/* ===== Grid ===== */
.grid-8 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  padding: 0 16px;
}
.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 14px 4px;
  background: #fff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  transition: .2s;
}
.grid-item:active { transform: scale(.93); box-shadow: var(--shadow-sm); }
.grid-icon {
  width: 40px; height: 40px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: var(--font-md);
  font-weight: 700;
  color: #fff;
}
.grid-icon.upload { background: linear-gradient(135deg, #2563EB, #60A5FA); }
.grid-icon.note { background: linear-gradient(135deg, #7C3AED, #A78BFA); }
.grid-icon.outline { background: linear-gradient(135deg, #0891B2, #22D3EE); }
.grid-icon.error { background: linear-gradient(135deg, #DC2626, #F87171); }
.grid-icon.chat { background: linear-gradient(135deg, #059669, #34D399); font-size: 11px; }
.grid-icon.buddy { background: linear-gradient(135deg, #D97706, #FBBF24); }
.grid-icon.plan { background: linear-gradient(135deg, #7C3AED, #C084FC); font-size: 11px; }
.grid-icon.gpa { background: linear-gradient(135deg, #DB2777, #F472B6); }
.grid-text { font-size: var(--font-xs); color: var(--gray-600); font-weight: 500; }

/* ===== Horizontal Scroll ===== */
.h-scroll {
  display: flex;
  gap: 10px;
  padding: 0 16px 4px;
  overflow-x: auto;
  scrollbar-width: none;
}
.h-scroll::-webkit-scrollbar { display: none; }
.h-card {
  flex-shrink: 0;
  width: 130px;
  background: #fff;
  border-radius: var(--radius-md);
  padding: 16px 14px;
  box-shadow: var(--shadow-sm);
  transition: .2s;
}
.h-card:active { transform: scale(.96); }
.h-card-emoji { font-size: 28px; margin-bottom: 8px; }
.h-card-title {
  font-size: var(--font-base);
  font-weight: 600;
  margin-bottom: 4px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.h-card-meta { font-size: var(--font-xs); color: var(--gray-400); }

/* ===== Search Bar ===== */
.search-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  background: #fff;
  border-radius: var(--radius-md);
  padding: 10px 14px;
  margin: 0 16px;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--gray-100);
  transition: .2s;
}
.search-bar:active { border-color: var(--primary-light); }
.search-icon { font-size: 16px; }
.search-placeholder { font-size: var(--font-md); color: var(--gray-400); flex: 1; }

/* ===== Modal ===== */
.modal-overlay {
  opacity: 0;
  pointer-events: none;
  position: fixed;
  inset: 0;
  z-index: 300;
  transition: opacity .25s ease;
}
.modal-overlay.show {
  opacity: 1;
  pointer-events: auto;
}
.modal-mask {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,.45);
}
.modal-box {
  position: absolute;
  bottom: 0;
  left: 0; right: 0;
  background: #fff;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 4px 20px env(safe-area-inset-bottom);
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform .3s cubic-bezier(.4,0,.2,1);
}
.modal-box.slide-in {
  transform: translateY(0);
}
.modal-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12px 0;
  position: relative;
}
.modal-indicator {
  width: 36px; height: 4px;
  background: var(--gray-300);
  border-radius: 2px;
  margin-bottom: 10px;
}
.modal-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--gray-800);
  width: 100%;
  text-align: left;
}
.modal-scroll {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
.modal-close-btn {
  margin: 12px 0 calc(12px + env(safe-area-inset-bottom));
  width: 100%;
  padding: 12px;
  font-size: var(--font-md);
}

/* ===== Buttons ===== */
.btn {
  border: none;
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
  text-align: center;
  transition: .2s;
}
.btn:active { opacity: .85; }
.btn-primary {
  background: var(--primary);
  color: #fff;
  padding: 10px 20px;
  border-radius: var(--radius-sm);
}
.btn-primary[disabled] { background: var(--gray-300); color: var(--gray-400); }

/* ===== Upload ===== */
.upload-hint { font-size: var(--font-sm); color: var(--gray-400); margin-bottom: 12px; }
.upload-zone {
  border: 2px dashed var(--gray-200);
  border-radius: var(--radius-md);
  padding: 28px;
  text-align: center;
  background: var(--gray-50);
  transition: .2s;
}
.upload-zone:active { border-color: var(--primary); background: var(--primary-bg); }
.upload-icon { font-size: 32px; margin-bottom: 6px; }
.upload-text { font-size: var(--font-md); color: var(--gray-500); }
.upload-progress-bar {
  height: 4px;
  background: var(--gray-200);
  border-radius: 2px;
  margin-top: 12px;
  overflow: hidden;
}
.upload-progress-fill {
  height: 100%;
  width: 60%;
  background: var(--primary);
  border-radius: 2px;
  animation: pulse 1.2s ease-in-out infinite;
}
.upload-done { margin-top: 14px; }
.upload-done-text {
  padding: 12px;
  background: var(--success-bg);
  border-radius: var(--radius-sm);
  font-size: var(--font-base);
  color: var(--success);
  margin-bottom: 10px;
}

/* ===== Note ===== */
.note-title { font-size: var(--font-lg); font-weight: 700; margin-bottom: 14px; color: var(--gray-800); }
.note-section { margin-bottom: 16px; }
.note-h3 {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 6px;
  padding-left: 10px;
  border-left: 3px solid var(--primary);
}
.note-li {
  font-size: var(--font-base);
  color: var(--gray-600);
  padding: 3px 0 3px 18px;
  position: relative;
  line-height: 1.6;
}
.note-li::before { content: '\2022'; color: var(--primary); position: absolute; left: 4px; }

/* ===== Outline ===== */
.section-sub-label { font-weight: 600; margin: 14px 0 8px; font-size: var(--font-md); color: var(--gray-700); }
.outline-card {
  padding: 12px 14px;
  background: var(--primary-bg);
  border-radius: var(--radius-sm);
  margin-bottom: 8px;
}
.outline-row { display: flex; justify-content: space-between; align-items: center; }
.outline-topic { font-weight: 600; font-size: var(--font-md); color: var(--gray-700); }
.outline-imp { font-size: var(--font-sm); color: var(--warning); }
.outline-tips { font-size: var(--font-sm); color: var(--gray-500); margin-top: 4px; line-height: 1.5; }
.predict-item {
  padding: 6px 12px;
  font-size: var(--font-base);
  color: var(--gray-600);
  background: var(--gray-50);
  border-radius: var(--radius-sm);
  margin-bottom: 4px;
}

/* ===== Error ===== */
.error-input {
  width: 100%;
  height: 90px;
  border: 1px solid var(--gray-200);
  border-radius: var(--radius-sm);
  padding: 10px;
  font-size: var(--font-base);
  margin-bottom: 10px;
  box-sizing: border-box;
}
.error-result { margin-top: 14px; }
.error-card { padding: 12px 14px; border-radius: var(--radius-sm); margin-bottom: 8px; }
.error-card.danger { background: var(--danger-bg); }
.error-card.info { background: var(--primary-bg); }
.error-card.success-card { background: var(--success-bg); }
.error-type {
  font-size: var(--font-base);
  font-weight: 600;
  display: block;
  margin-bottom: 4px;
}
.error-card.danger .error-type { color: var(--danger); }
.error-card.info .error-type { color: var(--primary); }
.error-card.success-card .error-type { color: var(--success); }
.error-text { font-size: var(--font-sm); color: var(--gray-600); display: block; padding: 2px 0; line-height: 1.6; }

/* ===== Chat ===== */
.chat-box { height: 280px; margin-bottom: 10px; padding: 10px; background: var(--gray-50); border-radius: var(--radius-sm); }
.chat-msg {
  padding: 10px 14px;
  border-radius: 12px;
  margin-bottom: 8px;
  font-size: var(--font-base);
  max-width: 85%;
  line-height: 1.5;
}
.chat-msg.ai {
  background: var(--primary-bg);
  border-radius: 12px 12px 12px 2px;
  color: var(--gray-700);
  margin-right: auto;
}
.chat-msg.user {
  background: var(--primary);
  color: #fff;
  border-radius: 12px 12px 2px 12px;
  margin-left: auto;
}
.chat-input-row { display: flex; gap: 8px; }
.chat-input {
  flex: 1;
  padding: 10px 14px;
  border: 1px solid var(--gray-200);
  border-radius: 20px;
  font-size: var(--font-base);
  height: 38px;
}
.chat-send { flex-shrink: 0; border-radius: 20px; height: 38px; line-height: 18px; }

/* ===== Buddy ===== */
.buddy-hint { font-size: var(--font-sm); color: var(--gray-400); margin-bottom: 14px; }
.buddy-card {
  display: flex; align-items: center; gap: 12px;
  background: #fff;
  border: 1px solid var(--gray-100);
  border-radius: var(--radius-md);
  padding: 14px;
  margin-bottom: 8px;
  transition: .2s;
}
.buddy-card:active { background: var(--gray-50); }
.buddy-avatar { font-size: 32px; }
.buddy-info { flex: 1; }
.buddy-name { font-size: var(--font-md); font-weight: 600; }
.buddy-meta { font-size: var(--font-sm); color: var(--gray-400); margin-top: 1px; }
.buddy-tags { display: flex; gap: 4px; margin-top: 6px; flex-wrap: wrap; }
.buddy-tag {
  font-size: var(--font-xs);
  background: var(--primary-bg);
  color: var(--primary);
  padding: 2px 10px;
  border-radius: 10px;
}
.buddy-btn {
  font-size: var(--font-sm);
  color: var(--primary);
  font-weight: 600;
  padding: 6px 14px;
  border: 1px solid var(--primary);
  border-radius: 16px;
  background: transparent;
  line-height: 1;
  transition: .2s;
}
.buddy-btn:active { background: var(--primary-bg); }

/* ===== Plan ===== */
.plan-courses { display: flex; gap: 8px; margin-bottom: 14px; }
.plan-cate {
  padding: 6px 16px;
  border-radius: 16px;
  font-size: var(--font-sm);
  background: var(--gray-100);
  color: var(--gray-500);
}
.plan-cate.active { background: var(--primary); color: #fff; }
.plan-hint { font-size: var(--font-sm); color: var(--gray-400); margin-bottom: 10px; }
.plan-task {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 0;
  border-bottom: 1px solid var(--gray-100);
}
.plan-checkbox { transform: scale(.85); }
.plan-task-text { font-size: var(--font-base); color: var(--gray-600); }
.plan-task-text.done { color: var(--gray-400); text-decoration: line-through; }
.plan-advice {
  margin-top: 14px;
  padding: 10px 14px;
  background: var(--primary-bg);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  color: var(--primary);
  line-height: 1.5;
}

/* ===== GPA ===== */
.gpa-row { display: flex; gap: 6px; margin-bottom: 8px; }
.gpa-name {
  flex: 2;
  padding: 10px;
  border: 1px solid var(--gray-200);
  border-radius: var(--radius-sm);
  font-size: var(--font-base);
  height: 38px;
  box-sizing: border-box;
}
.gpa-score, .gpa-credit {
  flex: 1;
  padding: 10px;
  border: 1px solid var(--gray-200);
  border-radius: var(--radius-sm);
  font-size: var(--font-base);
  height: 38px;
  text-align: center;
  box-sizing: border-box;
}
.gpa-add {
  width: 100%;
  padding: 10px;
  background: var(--gray-50);
  border: 1px dashed var(--gray-300);
  border-radius: var(--radius-sm);
  font-size: var(--font-base);
  color: var(--gray-400);
  text-align: center;
  margin-bottom: 10px;
  transition: .2s;
}
.gpa-add:active { background: var(--gray-100); }
.gpa-result {
  margin-top: 14px;
  padding: 18px;
  background: var(--success-bg);
  border-radius: var(--radius-md);
  text-align: center;
}
.gpa-result-label { font-size: var(--font-sm); color: var(--gray-500); display: block; }
.gpa-result-num { font-size: 34px; font-weight: 800; color: var(--success); display: block; margin-top: 4px; }

/* ===== Note Detail ===== */
.note-detail-course { font-size: var(--font-sm); color: var(--gray-400); margin-bottom: 12px; }
.note-detail-preview { font-size: var(--font-base); color: var(--gray-600); line-height: 1.8; }
.note-detail-ai {
  margin-top: 14px;
  padding: 12px 14px;
  background: var(--primary-bg);
  border-radius: var(--radius-sm);
  font-size: var(--font-base);
  color: var(--primary);
  line-height: 1.5;
}
